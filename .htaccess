# Datendateien (Budget, Con, Feed-Cache, Archive) nicht direkt über den Browser abrufbar machen
<FilesMatch "\.(json|tmp)$">
    Require all denied
</FilesMatch>

# Versteckte Dateien (Zugangsdaten, Protokoll, Einstellungen) sperren
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Interne PHP-Bausteine nicht direkt aufrufbar
RedirectMatch 404 ^.*/inc/.*$
# Private Daten, Werkzeuge und Client-Quelltext (Download nur angemeldet über nexus.php)
RedirectMatch 404 ^.*/(data|tools|clients)/.*$

# Anmelde-Kopfzeile an PHP durchreichen (Nexus-Desktop-Client), auch wenn PHP als CGI/FastCGI läuft
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

Options -Indexes
