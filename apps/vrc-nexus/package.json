{
  "name": "vrc-nexus-desktop",
  "productName": "VRC Nexus",
  "version": "1.0.0",
  "description": "VRC Nexus als eigenständige Windows-App: VRChat-Freunde, Verlauf, Statistik, Welten, Avatare, Gruppen, Kalender, Galerie, Benachrichtigungen, Shop, Spiel-Log & OSC – ohne Server.",
  "main": "main.js",
  "author": "GHOST NODE",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/backend.test.js",
    "dev-server": "node tests/server.js",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.ghostnode.vrcnexus",
    "productName": "VRC Nexus",
    "copyright": "GHOST NODE",
    "files": ["main.js", "backend/**", "renderer/**", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": ["portable", "nsis"], "icon": "build/icon.ico", "artifactName": "VRC-Nexus-${version}-${arch}-${target}.${ext}" },
    "portable": { "artifactName": "VRC-Nexus-${version}-portable.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "VRC-Nexus-${version}-Setup.exe", "shortcutName": "VRC Nexus" }
  }
}
