{
  "name": "vrc-nexus-desktop",
  "productName": "VRC Nexus",
  "version": "1.7.7",
  "description": "VRC Nexus als eigenständige Windows-App: VRChat-Freunde, Verlauf, Statistik, Welten, Avatare, Gruppen, Kalender, Galerie, Benachrichtigungen, Shop, Spiel-Log & OSC – ohne Server.",
  "main": "main.js",
  "author": "GHOST NODE",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/backend.test.js",
    "streamdeck": "node streamdeck/tools/pack.js",
    "streamdeck-icons": "python3 streamdeck/tools/make-icons.py",
    "dev-server": "node tests/server.js",
    "dist": "node streamdeck/tools/pack.js && electron-builder --win portable nsis"
  },
  "dependencies": {
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "26.0.12",
    "ws": "8.18.0"
  },
  "build": {
    "appId": "de.ghostnode.vrcnexus",
    "productName": "VRC Nexus",
    "copyright": "GHOST NODE",
    "files": [
      "main.js",
      "vroverlay.js",
      "backend/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "streamdeck/VRC-Nexus.streamDeckPlugin", "to": "VRC-Nexus.streamDeckPlugin" },
      { "from": "overlay/bin/Release/net48", "to": "overlay", "filter": ["NexusOverlay.exe", "NexusOverlay.exe.config", "openvr_api.dll", "input/*.json"] }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "VRC-Nexus-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "VRC-Nexus-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VRC-Nexus-${version}-Setup.exe",
      "shortcutName": "VRC Nexus"
    }
  }
}
