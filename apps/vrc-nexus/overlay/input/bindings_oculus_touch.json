{
  "controller_type": "oculus_touch",
  "description": "VRC Nexus – Overlay ein/aus (Doppeldruck)",
  "name": "VRC Nexus",
  "bindings": {
    "/actions/nexus": {
      "sources": [
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/nexus/in/toggle"
            }
          }
        }
      ]
    }
  }
}